# =====================================================================
# Krypton Agent — environment configuration
# Copy this file to `.env` and fill in the values you actually use.
# =====================================================================

# ---- Provider selection -------------------------------------------------
# Allowed: ollama_local | ollama_cloud | openrouter
KRYPTON_PROVIDER=ollama_local

# ---- Ollama (local instance) -------------------------------------------
OLLAMA_LOCAL_HOST=http://127.0.0.1:11434
OLLAMA_LOCAL_MODEL=qwen2.5-coder:7b

# ---- Ollama Cloud (hosted) ---------------------------------------------
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=gpt-oss:120b

# ---- OpenRouter --------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ---- Telegram ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric user IDs allowed to talk to the bot.
# Anyone else is silently ignored.
TELEGRAM_AUTHORIZED_USER_IDS=

# ---- Web search --------------------------------------------------------
# Optional Tavily key (faster, deeper results). If empty -> DuckDuckGo.
TAVILY_API_KEY=

# ---- Agent runtime -----------------------------------------------------
# Working directory the agent considers "home" for relative paths.
KRYPTON_WORKDIR=C:\Users\YourName\Desktop\Krypton Agent
# Max iterations of the think->act loop per user turn.
KRYPTON_MAX_ITERATIONS=40
# Context window target (in tokens) before compaction kicks in.
KRYPTON_CONTEXT_BUDGET=24000
# Where SQLite memory / patterns DB lives.
KRYPTON_DATA_DIR=C:\Users\YourName\Desktop\Krypton Agent\data
